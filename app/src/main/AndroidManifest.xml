<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- UpdateChecker polls the GitHub Releases API; AndroidUpdateInstaller downloads the APK. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Update-available notification (docs/ci.md / tasks/update-system.md). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Sideloaded installs go through ACTION_VIEW with an explicit user tap, never silently. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Task 1.1: SMS ingest. Denied is a supported state — the app still works with manual entry. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <application
        android:name=".app.LedgerlyApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:theme="@style/Theme.Ledgerly">

        <activity
            android:name=".ui.unlock.UnlockActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- AndroidUpdateInstaller.requestInstall() hands the downloaded APK to the system
             installer via a content:// URI rather than a file:// one (required since API 24). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Task 1.1: does no parsing (docs/parser.md) — archives RawSms and returns immediately.
             android:permission restricts delivery to the system's own protected broadcast. -->
        <receiver
            android:name=".ingest.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
